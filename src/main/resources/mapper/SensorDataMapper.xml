<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="shipsensor.inter.SensorDataMapper">

    <insert id="insertBatch" parameterType="java.util.List">

        INSERT INTO sensor_data
        (
        config_id,
        ship_id,
        data_value,
        recorded_at
        )
        VALUES

        <foreach
                collection="list"
                item="item"
                separator=",">

            (
            #{item.configId,jdbcType=BIGINT},
            #{item.shipId,jdbcType=BIGINT},
            #{item.dataValue,jdbcType=DOUBLE},
            #{item.recordedAt,jdbcType=TIMESTAMP}
            )

        </foreach>

    </insert>

</mapper>